# =============================================================================
# PricePilot — environment template
# Copy to `.env` (git-ignored) and fill in real values. NEVER commit `.env`.
# `docker compose up` reads `.env` into services unless overridden below.
# =============================================================================

# ----- App -----
APP_ENV=development                # development | test | production
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
PRICEPILOT_ENABLE_FIXTURES=false   # dev-only demo corpus; MUST stay false in prod

# ----- API -----
# Local dev uses dockerized Postgres/Redis (see docker-compose.yml).
# Production: Supabase DSN (includes SSLMODE=require) + managed Redis DSN (auth/TLS).
DATABASE_URL=postgresql+asyncpg://pricepilot:pricepilot@localhost:5432/pricepilot
REDIS_URL=redis://localhost:6379/0
# Connection-pool bounds (match managed Postgres connection limits; e.g. 5–10).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
JWT_SECRET=change-me-in-prod        # REQUIRED strong random value in production (guard fails fast otherwise)
PRICEPILOT_PUBLIC_BASE_URL=http://localhost:8000
# Production: exact frontend origin, e.g. https://app.yourdomain.com (no wildcard).
CORS_ORIGIN=http://localhost:3000

# ----- Worker / price monitoring (Phase 5) -----
MONITOR_ENABLED=true
MONITOR_POLL_INTERVAL_SECONDS=3600
MONITOR_PROVIDER_TIMEOUT_SECONDS=15.0
MONITOR_MAX_CONCURRENCY=4
MONITOR_RETRY_COUNT=2
MONITOR_OBSERVATION_WINDOW_SECONDS=3600

# ----- Notifications (Phase 5; optional) -----
# Set PRICEPILOT_NOTIFICATION_PROVIDER=email and the SMTP_* values to enable.
# Empty → alerts persist in-app only (honest "unavailable" external delivery).
PRICEPILOT_NOTIFICATION_PROVIDER=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=

# ----- AI providers (all optional) -----
# openai-compatible (OpenAI/Anthropic/Azure/AgentRouter/… via compatible endpoint) or "ollama"
AI_PROVIDER=openai-compatible
AI_MODEL=deepseek-v4-flash
# AgentRouter is OpenAI-compatible. Base URL example: https://agentrouter.org/v1
AI_API_KEY=
AI_BASE_URL=https://agentrouter.org/v1
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=2048
AI_EMBEDDING_MODEL=text-embedding-3-small

# ----- Embedding / vision / review providers (Phase 4, all optional) -----
# Set "openai-compatible" for embeddings (requires AI_API_KEY). Vision/review
# backends are not yet implemented; leaving these empty degrades honestly.
PRICEPILOT_EMBEDDING_PROVIDER=
PRICEPILOT_VISION_PROVIDER=
PRICEPILOT_REVIEW_PROVIDER=

# ----- Search providers -----
# OpenFoodFacts: public API, no key required.
PRICEPILOT_SEARCH_PROVIDER=openfoodfacts
OFF_API_BASE_URL=https://world.openfoodfacts.org
OFF_TIMEOUT_SECONDS=12
OFF_MAX_PAGE_SIZE=20

# ----- Web -----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000