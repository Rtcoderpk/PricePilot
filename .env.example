# =============================================================================
# PricePilot — environment template
# Copy to `.env` (git-ignored) and fill in real values. NEVER commit `.env`.
# `docker compose up` reads `.env` into services unless overridden below.
# =============================================================================

# ----- App -----
APP_ENV=development                # development | test | production
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
PRICEPILOT_ENABLE_FIXTURES=false   # dev-only demo corpus; MUST stay false in prod

# ----- API -----
# Local dev uses dockerized Postgres/Redis (see docker-compose.yml).
DATABASE_URL=postgresql+asyncpg://pricepilot:pricepilot@localhost:5432/pricepilot
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-in-prod        # auth is deferred; placeholder only
PRICEPILOT_PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGIN=http://localhost:3000

# ----- Worker -----
ALERT_SWEEP_INTERVAL_SECONDS=300
PRICE_POLL_INTERVAL_SECONDS=3600
MAX_ALERTS_PER_SWEEP=100

# ----- AI providers (all optional in Phase 1) -----
# openai-compatible (OpenAI/Anthropic/Azure/… via compatible endpoint) or "ollama"
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=2048

# ----- Search providers -----
# OpenFoodFacts: public API, no key required.
PRICEPILOT_SEARCH_PROVIDER=openfoodfacts
OFF_API_BASE_URL=https://world.openfoodfacts.org
OFF_TIMEOUT_SECONDS=12
OFF_MAX_PAGE_SIZE=20

# ----- Web -----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000